# Postgres connection string (local dev: Docker container from docker-compose.yml)
DATABASE_URI=postgres://postgres:postgres@localhost:5432/isad
# Secret used by Payload to encrypt/sign tokens — generate with: openssl rand -hex 32
PAYLOAD_SECRET=YOUR_PAYLOAD_SECRET_HERE
# Canonical public URL of the site (production: https://isad.academy)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Brevo API key (marketing + transactional email) — empty uses NoopMailer (dev no-op, T7)
BREVO_API_KEY=
# Brevo contact list ID for newsletter double opt-in subscribers
BREVO_NEWSLETTER_LIST_ID=
# Brevo template ID for the double opt-in confirmation email (POST /contacts/doubleOptinConfirmation)
BREVO_DOI_TEMPLATE_ID=
# "From" address for every Brevo transactional/broadcast email
BREVO_SENDER_EMAIL=
# "From" display name for every Brevo transactional/broadcast email
BREVO_SENDER_NAME=
# Reply-To for every outgoing email (the monitored inbox, e.g. contact@isad.academy);
# empty = no Reply-To header. Lead notifications override it with the lead's own email.
BREVO_REPLY_TO_EMAIL=
# Google Analytics 4 measurement ID (consent-gated, lazy-loaded)
NEXT_PUBLIC_GA4_ID=
# Google Tag Manager container ID (consent-gated, lazy-loaded)
NEXT_PUBLIC_GTM_ID=
# Payment provider: mock | stripe | netopia | euplatesc (MockProvider by default)
PAYMENT_PROVIDER=mock
# --- Netopia (PAYMENT_PROVIDER=netopia, API v2 hosted payment page) ---
# API key + POS signature from the Netopia admin (sandbox keys: sandbox.netopia-payments.com)
NETOPIA_API_KEY=
NETOPIA_POS_SIGNATURE=
# Sandbox by default — test cards only, no real money. Set EXACTLY 'false' to charge live.
NETOPIA_SANDBOX=true
# Public certificate (PEM) from the Netopia admin — verifies IPN signatures. Paste the raw
# PEM (escaped \n allowed) or the whole PEM base64-encoded on one line.
NETOPIA_PUBLIC_KEY=
# Staging escape hatch: allows the auto-confirming mock provider under NODE_ENV=production.
# NEVER set this in production — it would sell every seat for free. Leave unset everywhere else.
ALLOW_MOCK_PAYMENTS=
# Secret protecting scheduled-job endpoints (Vercel Cron) — generate with: openssl rand -hex 32
CRON_SECRET=YOUR_CRON_SECRET_HERE
# PRODUCTION ONLY (cPanel app env): 'true' makes Payload apply src/migrations at app start.
# Leave UNSET locally and during builds — `next build` also runs with NODE_ENV=production, so
# without the gate the build workers would apply migrations concurrently (locks + timeouts).
# A production deploy that adds migrations WILL break pages until this is set (owner 2026-07-30).
RUN_MIGRATIONS=

# Invoicing (B8 — SmartBill track; scaffold only, default off)
INVOICE_PROVIDER=none        # none | smartbill
SMARTBILL_USERNAME=
SMARTBILL_TOKEN=
SMARTBILL_CIF=
SMARTBILL_SERIES=
