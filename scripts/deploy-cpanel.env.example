# Configurare pentru scripts/deploy-cpanel.sh
#
# COPIAZĂ acest fișier ÎN AFARA repo-ului (de ex. C:\Users\<tu>\isad-deploy.env),
# completează-l și pasează calea ca prim argument scriptului. NU îl comite niciodată:
# conține datele de acces la serverul de producție.
#
#   scripts/deploy-cpanel.sh ~/isad-deploy.env

# --- Acces SSH la Hosterion (aceleași valori ca secretele din GitHub Actions) ---
SSH_HOST=
SSH_PORT=22
SSH_USER=
# Calea către cheia PRIVATĂ (fără passphrase, altfel scriptul nu poate rula neinteractiv).
# Cheia publică pereche trebuie să fie în ~/.ssh/authorized_keys pe server —
# se poate adăuga din cPanel → SSH Access → Manage SSH Keys.
SSH_KEY=/c/Users/andvr/.ssh/isad_deploy

# --- Aplicația pe server ---
# Calea aplicației Node din cPanel (Setup Node.js App → Application root), de ex. ~/apps/isad
APP_DIR=

# --- Baza de date de producție ---
# String-ul de conexiune valabil DE PE SERVER (de obicei pe localhost). Folosit doar pentru
# `pg_dump`, rulat pe server; nu se conectează nimic de pe mașina ta direct la DB.
PROD_DATABASE_URI=

# --- Opționale ---
# Domeniul public; ajunge în bundle-ul de client, deci trebuie să fie cel real.
SITE_URL=https://isad.academy
# Payload cere un secret la build. Cel REAL e citit din env-ul aplicației de pe cPanel la
# runtime, deci aici e suficient un placeholder — lasă gol dacă nu îl ai.
PAYLOAD_SECRET=
# Containerul de Postgres local și baza în care se restaurează snapshot-ul de producție.
# Baza de dev (`isad`) NU e atinsă.
PG_CONTAINER=isad-postgres
SNAPSHOT_DB=isad_deploy
