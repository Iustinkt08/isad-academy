{
  "name": "isad-academy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^18.20.2 || >=20.9.0"
  },
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:int": "vitest run tests/int --no-file-parallelism",
    "test:e2e": "playwright test",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/seed.ts",
    "jobs:run": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/run-review-requests.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.85.2",
    "@payloadcms/next": "3.85.2",
    "@payloadcms/plugin-seo": "3.85.2",
    "@payloadcms/richtext-lexical": "3.85.2",
    "@react-pdf/renderer": "^4.9.0",
    "cross-env": "^7.0.3",
    "graphql": "^16.11.0",
    "jsdom": "^29.1.1",
    "next": "~15.4.11",
    "payload": "3.85.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.34.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.54.0",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "dotenv": "^16.5.0",
    "eslint": "^9.30.0",
    "eslint-config-next": "~15.4.11",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
